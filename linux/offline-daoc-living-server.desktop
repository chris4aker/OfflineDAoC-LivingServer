[Desktop Entry]
# Template for install-desktop-entry.sh, which fills in @START@ and @GAME@ and writes the result to
# ~/.local/share/applications. Don't copy this file there by hand: the placeholders would stay.
Type=Application
Version=1.5
Name=Offline DAoC
GenericName=Living Server
Comment=Start Offline DAoC with Living Server under Wine
Icon=offline-daoc-living-server
Exec=@START@ @GAME@
Path=@GAME@
Terminal=false
Categories=Game;RolePlaying;
Keywords=DAoC;Dark Age of Camelot;Living Server;Offline;Wine;
StartupNotify=true
StartupWMClass=offlinedaoc.exe
