{
    "name": "b2-herald-pages",
    "note": "Camelot Herald 2002-2005: front page through time, server and population pages, realm war, patch notes and class/server statistics, if the Herald had them. Keyword targets search the whole domain by URL words because the exact paths are not known yet; b1-herald-map lists the real paths.",
    "from": "2002",
    "to": "2005",
    "mimetypes": ["text/html"],
    "exclude": ["/(chars|guilds)/"],
    "maxCaptures": 260,
    "targets": [
        {
            "url": "www.camelotherald.com/",
            "matchType": "exact",
            "guess": false,
            "note": "The front page, one capture a month (collapse=timestamp:6): news, server status.",
            "collapse": "timestamp:6",
            "cdxPageSize": 100, "cdxMaxPages": 1, "maxCaptures": 48
        },
        {
            "url": "camelotherald.com/newfrontiers/",
            "matchType": "prefix",
            "guess": false,
            "note": "Seen in a May 2004 link to /newfrontiers/realmabilities/abilities.php (the New Frontiers RvR and realm ability pages).",
            "cdxPageSize": 200, "cdxMaxPages": 1, "maxCaptures": 30
        },
        {
            "url": "camelotherald.com",
            "matchType": "domain",
            "guess": true,
            "note": "GUESS by keyword: statistics pages (class, server, population, top lists).",
            "cdxFilters": ["urlkey:.*(stat|population|census|topxp|top_|toprp|ranking).*", "!urlkey:.*/(chars|guilds)/.*"],
            "cdxPageSize": 200, "cdxMaxPages": 2, "maxCaptures": 50
        },
        {
            "url": "camelotherald.com",
            "matchType": "domain",
            "guess": true,
            "note": "GUESS by keyword: realm war, keeps, relics and server pages.",
            "cdxFilters": ["urlkey:.*(realmwar|realm_war|rvr|keep|relic|server).*", "!urlkey:.*/(chars|guilds)/.*"],
            "cdxPageSize": 200, "cdxMaxPages": 2, "maxCaptures": 50
        },
        {
            "url": "camelotherald.com",
            "matchType": "domain",
            "guess": true,
            "note": "GUESS by keyword: patch and release notes.",
            "cdxFilters": ["urlkey:.*(release|patch|notes).*", "!urlkey:.*/(chars|guilds)/.*"],
            "cdxPageSize": 200, "cdxMaxPages": 2, "maxCaptures": 50
        },
        {
            "url": "camelotherald.com/classes",
            "matchType": "prefix",
            "guess": true,
            "note": "GUESS: class description pages.",
            "cdxPageSize": 200, "cdxMaxPages": 1, "maxCaptures": 30
        }
    ]
}
