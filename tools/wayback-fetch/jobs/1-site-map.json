{
    "name": "1-site-map",
    "note": "INDEX ONLY, downloads no pages, runs first because it is cheap: lists the distinct URLs archived 2002-2005 on the Camelot Herald (one prefix range per first letter a-z), Mythic's official site and Classes of Camelot. Its out\\1-site-map\\index.csv shows the real URL forms of class, realm ability, lore, news and patch pages, to fill and correct jobs 2-5 on the next pass.",
    "indexOnly": true,
    "from": "2002",
    "to": "2005",
    "mimetypes": [
        "text/html"
    ],
    "targets": [
        {
            "url": "www.camelotherald.com/",
            "matchType": "exact",
            "guess": false,
            "note": "The Herald front page itself.",
            "cdxPageSize": 50,
            "cdxMaxPages": 1
        },
        {
            "url": "camelotherald.com/a",
            "matchType": "prefix",
            "guess": false,
            "note": "Herald paths starting with 'a'.",
            "cdxPageSize": 1000,
            "cdxMaxPages": 3
        },
        {
            "url": "camelotherald.com/b",
            "matchType": "prefix",
            "guess": false,
            "note": "Herald paths starting with 'b'.",
            "cdxPageSize": 1000,
            "cdxMaxPages": 3
        },
        {
            "url": "camelotherald.com/c",
            "matchType": "prefix",
            "guess": false,
            "note": "Herald paths starting with 'c', without the 8,600+ chardisplay.php character pages and ~1,070 /calendar/ pages that filled the first map. Character pages are not wanted.",
            "cdxPageSize": 1000,
            "cdxMaxPages": 4,
            "cdxFilters": [
                "!urlkey:.*/chardisplay.php.*",
                "!urlkey:.*/calendar/.*"
            ]
        },
