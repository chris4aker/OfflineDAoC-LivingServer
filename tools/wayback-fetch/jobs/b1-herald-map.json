{
    "name": "b1-herald-map",
    "note": "INDEX ONLY, downloads no pages: lists the distinct camelotherald.com URLs archived 2002-2005, one prefix range per first letter of the path (a-z), so a big section (chardisplay.php, /calendar/) can no longer use up the whole listing as the first run's single domain query did. Read out\\b1-herald-map\\index.csv. Not covered: paths starting with a digit or symbol, and subdomains.",
    "from": "2002",
    "to": "2005",
    "mimetypes": [
        "text/html"
    ],
    "indexOnly": true,
    "targets": [
        {
            "url": "www.camelotherald.com/",
            "matchType": "exact",
            "guess": false,
            "note": "The front page itself.",
            "cdxPageSize": 50,
            "cdxMaxPages": 1
        },
        {
            "url": "camelotherald.com/a",
            "matchType": "prefix",
            "guess": false,
            "note": "Every distinct URL whose path starts with 'a'.",
            "cdxPageSize": 1000,
            "cdxMaxPages": 3
        },
        {
            "url": "camelotherald.com/b",
            "matchType": "prefix",
            "guess": false,
            "note": "Every distinct URL whose path starts with 'b'.",
            "cdxPageSize": 1000,
            "cdxMaxPages": 3
        },
        {
            "url": "camelotherald.com/c",
            "matchType": "prefix",
            "guess": false,
            "note": "Paths starting with 'c', without the 8,600+ chardisplay.php character pages and ~1,070 /calendar/ pages that filled the first map (job c fetches character pages).",
            "cdxPageSize": 1000,
            "cdxMaxPages": 4,
            "cdxFilters": [
                "!urlkey:.*/chardisplay.php.*",
                "!urlkey:.*/calendar/.*"
            ]
        },
        {
            "url": "camelotherald.com/d",
            "matchType": "prefix",
            "guess": false,
            "note": "Every distinct URL whose path starts with 'd'.",
            "cdxPageSize": 1000,
