// Offline DAoC Living Server -> Loki. Ships only allowlisted rows, minus fields that could carry a name.
// Environment: OFFLINEDAOC_LOGS (the server's logs folder, required), LOKI_URL (default the local Loki),
// LOKI_USERNAME / LOKI_PASSWORD (Grafana Cloud only), OFFLINEDAOC_BUILD (a build label), OFFLINEDAOC_TZ
// (the server PC's IANA time zone; default the local one). Nothing secret is written in this file.

local.file_match "offlinedaoc" {
	path_targets = [
		{"__path__" = file.path_join(sys.env("OFFLINEDAOC_LOGS"), "server*.log"), "log" = "server", "job" = "offlinedaoc"},
		{"__path__" = file.path_join(sys.env("OFFLINEDAOC_LOGS"), "detail*.log"), "log" = "detail", "job" = "offlinedaoc"},
	]
	sync_period = "10s"
}

loki.source.file "offlinedaoc" {
	targets    = local.file_match.offlinedaoc.targets
	forward_to = [loki.process.offlinedaoc.receiver]
}

