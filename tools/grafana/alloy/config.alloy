	}

	stage.template {
		source   = "layout"
		template = "{{ if .ts }}ok{{ else }}no{{ end }}"
	}

	stage.drop {
		source              = "layout"
		value               = "no"
		drop_counter_reason = "not_a_server_line"
	}

	stage.output {
		source = "msg"
