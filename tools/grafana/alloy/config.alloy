			expression = "( (?:leader|member)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:AUTONOMOUS_GROUP_LEADER_REPLACED)(?: |$)\""

		stage.replace {
			expression = "( (?:leader|old)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BOT_LED_INVITE)(?: |$)\""

		stage.replace {
			expression = "( (?:leader|player)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RAID_PLAYER_INVITE)(?: |$)\""

		stage.replace {
			expression = "( (?:leader|player|steppedOut)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:AUTONOMOUS_GROUP_BATTLEGROUND_TRIP_LEADER)(?: |$)\""

		stage.replace {
			expression = "( (?:leader|was)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BOT_MILESTONE_TALK)(?: |$)\""

		stage.replace {
			expression = "( (?:line)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:TALE_FIRESIDE)(?: |$)\""

		stage.replace {
			expression = "( (?:listener|player|teller)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_DISPLACEMENT_BOUNCED)(?: |$)\""

		stage.replace {
			expression = "( (?:living)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_ASSIST_CALL)(?: |$)\""

		stage.replace {
			expression = "( (?:mainAssist|target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_BACKLINE)(?: |$)\""

		stage.replace {
			expression = "( (?:member)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_INTERRUPT)(?: |$)\""

		stage.replace {
			expression = "( (?:member|subject)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_ASSIST_SWITCH)(?: |$)\""

		stage.replace {
			expression = "( (?:member|target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:AUTONOMOUS_GROUP_ASSEMBLED|AUTONOMOUS_GROUP_BATTLEGROUND_TRIP_ENDED|AUTONOMOUS_GROUP_FORMED|AUTONOMOUS_GROUP_REGROUP_STARTED|AUTONOMOUS_GROUP_RUN|AUTONOMOUS_GROUP_TASK_ENDED|REALM_RAID_FORCED_PARTY|REALM_RAID_FORCED_PARTY_RETRY|RVR_SIEGE_PARTY_FORMED)(?: |$)\""

		stage.replace {
			expression = "( (?:members)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BOT_SKILL_GROWTH|BOT_SKILL_MISTAKE|BOT_SKILL_PROFILE|DRAGON_FLIGHT_CUT_SHORT|DRAGON_HEALTH|DRAGON_LANDED|DRAGON_LANDING_APPROACH|DRAGON_LANDING_FORCED|DRAGON_RESET|DRAGON_TAKEOFF|EPIC_SWEEP_RAID_START|GOLD_SPAMMER_BANNED|GOLD_SPAMMER_START|LIVING_SERVER_FIRST|LOREMASTER_SPAWNED|RVR_EVENT_OPENED)(?: |$)\""

		stage.replace {
			expression = "( (?:name)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:PLAYER_CLICK_TARGET)(?: |$)\""

		stage.replace {
			expression = "( (?:name|player)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_EXPEDITION_CLEAR_FIRST)(?: |$)\""

		stage.replace {
			expression = "( (?:names)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_EXPEDITION_RESPAWNS_LEFT|REALM_EXPEDITION_ROUTE_BLOCKED)(?: |$)\""

		stage.replace {
			expression = "( (?:nearest)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_EXPEDITION_TACTIC_KEPT)(?: |$)\""

		stage.replace {
			expression = "( (?:note)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:PATH_CLOSED_DOOR_HOLD)(?: |$)\""

		stage.replace {
			expression = "( (?:npc)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:HIRED_COMPANION|HIRED_COMPANION_DISMISSED|HIRED_COMPANION_LOGIN|HIRED_COMPANION_LOGOUT|HIRED_COMPANION_ORPHAN|HIRED_COMPANION_RELEASED|HIRED_COMPANION_SUMMONED)(?: |$)\""

		stage.replace {
			expression = "( (?:owner)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BOT_PET_STUCK_RECOVERY)(?: |$)\""

		stage.replace {
			expression = "( (?:owner|pet)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_KVASIR_HEALED)(?: |$)\""

		stage.replace {
			expression = "( (?:owner|source|target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_SIEGE_OUTPUT)(?: |$)\""

		stage.replace {
			expression = "( (?:owner|target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RELIC_RETURNED|RELIC_RETURN_FAILED)(?: |$)\""

		stage.replace {
			expression = "( (?:pad)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BG_TOWER_FOOT)(?: |$)\""

		stage.replace {
			expression = "( (?:path)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BEGGAR_MARKED|BOT_LED_GROUP_GOING_ON|BOT_LED_PLAYER_LEFT|BUFF_REFUSAL|COMPANIONUI_CMD|COMPANION_DELVE_165|COMPANION_REPAIR_165|COMPANION_STATS_165|CRAFT_PLAYER_TITLE|DOOR_NOT_IN_DATABASE|HIRE_CMD|HIRE_PREVIEW_165|HIRE_WORD_165|PLAYER_TAXI_DISMOUNT_REQUEST|PLAYER_TAXI_SYNC|QUEST_XP|RAID_BOTS_DISPERSED|RAID_BOTS_REGROUPED|RAID_SQUAD_STATUS|RVR_ODD|RVR_PLAYER_KILLED|RVR_PLAYER_NOTICED|RVR_PLAYER_SEAT|RVR_PLAYER_VIEW|STORYLINE_SIDE|TALE_ASIDE|TALE_REQUEST)(?: |$)\""

		stage.replace {
			expression = "( (?:player)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:CHAT_PLAYER_REPLY_PLAN)(?: |$)\""

		stage.replace {
			expression = "( (?:player|shape)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:PLAYER_DEED)(?: |$)\""

		stage.replace {
			expression = "( (?:player|target|witness)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_SWEEP_GUEST)(?: |$)\""

		stage.replace {
			expression = "( (?:player|to)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_SPREAD_TARGET)(?: |$)\""

		stage.replace {
			expression = "( (?:prev)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:RVR_ROAM_HUNT)(?: |$)\""

		stage.replace {
			expression = "( (?:prey)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_RAID_HUB_POST_REJECTED)(?: |$)\""

		stage.replace {
			expression = "( (?:rejectedBy)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:AUTONOMOUS_GROUP_PARTIAL_ROSTER)(?: |$)\""

		stage.replace {
			expression = "( (?:removed)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_RAID_DRAGON_ENGAGE|REALM_RAID_DRAGON_REGROUP|REALM_RAID_DRAGON_REGROUP_UNREACHABLE)(?: |$)\""

		stage.replace {
			expression = "( (?:roster)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_LOSSREN_KEPT_SOUL)(?: |$)\""

		stage.replace {
			expression = "( (?:soul)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_FUNUS_HEALED_TRACE)(?: |$)\""

		stage.replace {
			expression = "( (?:source|stack)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_FUNUS_HEALED)(?: |$)\""

		stage.replace {
			expression = "( (?:source|target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:LIVING_SERVER_ALARM)(?: |$)\""

		stage.replace {
			expression = "( (?:speaker)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_FIGHT_LEDGER|EPIC_LEECH_EXPOSURE|REALM_EXPEDITION_ATTEMPT_ENDED|REALM_EXPEDITION_BARRED|REALM_EXPEDITION_COURT_LEASH|REALM_EXPEDITION_COURT_WINDOW|REALM_EXPEDITION_EARLY_PULL|REALM_EXPEDITION_ENCOUNTER_RESET|REALM_EXPEDITION_FINAL_MUSTER|REALM_EXPEDITION_FRONT_REFRESHED|REALM_EXPEDITION_HOLD|REALM_EXPEDITION_LATE_OBJECTIVE_LEFT|REALM_EXPEDITION_MUSTER_GUARDED|REALM_EXPEDITION_MUSTER_MOVED|REALM_EXPEDITION_MUSTER_UNREACHABLE|REALM_EXPEDITION_MUSTER_UNSAFE|REALM_EXPEDITION_MUSTER_WAITS_FOR_WAVE|REALM_EXPEDITION_PULL_UNREACHED|REALM_EXPEDITION_PULL_WAIT|REALM_EXPEDITION_PULL_WAIT_EXPIRED|REALM_EXPEDITION_PULL_WAIT_GUARDED|REALM_EXPEDITION_PULL_WAIT_GUARD_CLEAR|REALM_EXPEDITION_PULL_WAIT_GUARD_HOLDS|REALM_EXPEDITION_REGROUP_REFUSED|REALM_EXPEDITION_REGROUP_THREATENED|REALM_EXPEDITION_SKIRMISH_LOST|REALM_EXPEDITION_TARGET_CALLED|REALM_EXPEDITION_TARGET_DEFEATED|REALM_EXPEDITION_TARGET_HEALED|REALM_RAID_STALL_CLOCK|RUMOUR_NAMED|RUMOUR_NAMED_CHECK)(?: |$)\""

		stage.replace {
			expression = "( (?:target)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:REALM_EXPEDITION_MUSTER_STALLED)(?: |$)\""

		stage.replace {
			expression = "( (?:target|turnsOn)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_TACTIC_RESCUE)(?: |$)\""

		stage.replace {
			expression = "( (?:team)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:BOT_DEBATE_START)(?: |$)\""

		stage.replace {
			expression = "( (?:teller)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:CHAT_SCREEN|LORE_LINE|REALM_SCREEN_NOTICE)(?: |$)\""

		stage.replace {
			expression = "( (?:text)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.match {
		selector = "{job=\"offlinedaoc\"} |~ \"^(?:EPIC_SPREAD_LANDED)(?: |$)\""

		stage.replace {
			expression = "( (?:who)=(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^ ]*))"
			replace    = ""
		}
	}

	stage.replace {
		expression = "\"(?:account|accountName|bot|botName|guild|guildName|killer|leader|leaderName|name|owner|ownerName|player|playerName|speaker|text|victim)\":(\"(?:[^\"\\\\]|\\\\.)*\"|\\[[^\\]]*\\])"
		replace    = "\"-\""
	}

	stage.replace {
		expression = "\\b(\\d{1,3}(?:\\.\\d{1,3}){3})\\b"
		replace    = "-"
	}

	// 4. Labels: row and realm (low cardinality), the time from the line.
	stage.regex {
		expression = "^(?P<row>[A-Z][A-Z0-9_]*)"
	}

	stage.logfmt {
		mapping = {"realm_raw" = "realm"}
	}

	stage.template {
		source   = "realm"
		template = "{{ with .realm_raw }}{{ if or (eq . \"Albion\") (eq . \"1\") }}Albion{{ else if or (eq . \"Midgard\") (eq . \"2\") }}Midgard{{ else if or (eq . \"Hibernia\") (eq . \"3\") }}Hibernia{{ else }}other{{ end }}{{ end }}"
	}

	stage.labels {
		values = {"row" = "", "realm" = ""}
	}

	stage.timestamp {
		source   = "ts"
		format   = "01/02 15:04:05"
		location = coalesce(sys.env("OFFLINEDAOC_TZ"), "Local")
	}

	stage.label_drop {
		values = ["filename"]
	}
}

loki.write "offlinedaoc" {
	external_labels = {"build" = coalesce(sys.env("OFFLINEDAOC_BUILD"), "unset")}

	endpoint {
		url = coalesce(sys.env("LOKI_URL"), "http://127.0.0.1:3100/loki/api/v1/push")

		basic_auth {
			username = sys.env("LOKI_USERNAME")
			password = sys.env("LOKI_PASSWORD")
		}
	}
}
