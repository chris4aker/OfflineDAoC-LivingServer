{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "offlinedaoc-server-health",
    "annotations": {
      "grafana.app/folder": "offlinedaoc-living-server"
    }
  },
  "spec": {
    "title": "Living Server: Server health",
    "description": "SERVER_STALL, SERVER_HEAP_SNAPSHOT and the censuses. Generated by tools/grafana/kit.py; edit dashboards.py, not this file.",
    "tags": [
      "offlinedaoc",
      "living-server"
    ],
    "editable": true,
    "schemaVersion": 41,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "Loki",
          "type": "datasource",
          "query": "loki",
          "current": {
            "text": "Offline DAoC Loki",
            "value": "offlinedaoc-loki"
          },
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Worst tick per minute, ms",
        "description": "Rows: SERVER_STALL.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "max(max_over_time({job=\"offlinedaoc\", row=\"SERVER_STALL\"} | logfmt | unwrap worstTickMs | __error__=\"\" [$__auto]))",
            "legendFormat": "worst tick",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "GC pause per stall minute, ms",
        "description": "Rows: SERVER_STALL.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "max(max_over_time({job=\"offlinedaoc\", row=\"SERVER_STALL\"} | logfmt | unwrap gcPauseMs | __error__=\"\" [$__auto]))",
            "legendFormat": "GC pause",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Heap at stalls, MB",
        "description": "Rows: SERVER_STALL.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "max(max_over_time({job=\"offlinedaoc\", row=\"SERVER_STALL\"} | logfmt | unwrap heapMB | __error__=\"\" [$__auto]))",
            "legendFormat": "heap",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Heap snapshots, MB",
        "description": "Rows: SERVER_HEAP_SNAPSHOT.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "max(max_over_time({job=\"offlinedaoc\", row=\"SERVER_HEAP_SNAPSHOT\"} | logfmt | unwrap heapMB | __error__=\"\" [$__auto]))",
            "legendFormat": "heap",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Census rows",
        "description": "Rows: SERVER_NPC_CENSUS, SERVER_HANDLE_CENSUS, SERVER_STATIC_CENSUS, SERVER_HOLDER_CENSUS, SERVER_BOT_FIELD_CENSUS.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (row) (count_over_time({job=\"offlinedaoc\", row=~\"SERVER_NPC_CENSUS|SERVER_HANDLE_CENSUS|SERVER_STATIC_CENSUS|SERVER_HOLDER_CENSUS|SERVER_BOT_FIELD_CENSUS\"} [$__auto]))",
            "legendFormat": "{{row}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Server starts (FORK_BUILD)",
        "description": "Rows: FORK_BUILD.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (build) (count_over_time({job=\"offlinedaoc\", row=\"FORK_BUILD\"} [$__auto]))",
            "legendFormat": "{{build}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      }
    ]
  }
}
