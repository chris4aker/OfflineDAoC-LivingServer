{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "offlinedaoc-combat",
    "annotations": {
      "grafana.app/folder": "offlinedaoc-living-server"
    }
  },
  "spec": {
    "title": "Living Server: Combat",
    "description": "CAST_INTERRUPT and CC_BREAK (#625, #596, #621). Generated by tools/grafana/kit.py; edit dashboards.py, not this file.",
    "tags": [
      "offlinedaoc",
      "living-server"
    ],
    "editable": true,
    "schemaVersion": 41,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "Loki",
          "type": "datasource",
          "query": "loki",
          "current": {
            "text": "Offline DAoC Loki",
            "value": "offlinedaoc-loki"
          },
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Interrupted casts: kept or lost, by caster kind",
        "description": "Rows: CAST_INTERRUPT.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (caster, outcome) (count_over_time({job=\"offlinedaoc\", row=\"CAST_INTERRUPT\"} | logfmt [$__auto]))",
            "legendFormat": "{{caster}} {{outcome}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Interrupt timer left at half-cast, median ms",
        "description": "Rows: CAST_INTERRUPT.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "quantile_over_time(0.5, {job=\"offlinedaoc\", row=\"CAST_INTERRUPT\"} | logfmt | unwrap leftMs | __error__=\"\" [$__auto]) by (caster)",
            "legendFormat": "{{caster}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "CC breaks by kind and side",
        "description": "Rows: CC_BREAK.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (cc, side) (count_over_time({job=\"offlinedaoc\", row=\"CC_BREAK\"} | logfmt [$__auto]))",
            "legendFormat": "{{cc}} {{side}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "CC held before the break, median ms",
        "description": "Rows: CC_BREAK.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "quantile_over_time(0.5, {job=\"offlinedaoc\", row=\"CC_BREAK\"} | logfmt | unwrap ms | __error__=\"\" [$__auto]) by (cc)",
            "legendFormat": "{{cc}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      }
    ]
  }
}
