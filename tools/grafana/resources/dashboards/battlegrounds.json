              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (bg) (max_over_time({job=\"offlinedaoc\", row=\"BG_POPULATION\"} | logfmt | unwrap expected | __error__=\"\" [10m]) by (bg, realm))",
            "legendFormat": "{{bg}}",
            "queryType": "range",
            "editorMode": "code"
