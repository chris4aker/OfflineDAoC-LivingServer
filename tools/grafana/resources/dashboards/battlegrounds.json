{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "offlinedaoc-battlegrounds",
    "annotations": {
      "grafana.app/folder": "offlinedaoc-living-server"
    }
  },
  "spec": {
    "title": "Living Server: Battlegrounds",
    "description": "BG_POPULATION, BG_TARGET_PICK, BG_RALLY_RESPONSE (#625, #610, #621). Generated by tools/grafana/kit.py; edit dashboards.py, not this file.",
    "tags": [
      "offlinedaoc",
      "living-server"
    ],
    "editable": true,
    "schemaVersion": 41,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "Loki",
          "type": "datasource",
          "query": "loki",
          "current": {
            "text": "Offline DAoC Loki",
            "value": "offlinedaoc-loki"
          },
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Bots per battleground (largest 10-min count, all realms)",
        "description": "Rows: BG_POPULATION.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (bg) (max_over_time({job=\"offlinedaoc\", row=\"BG_POPULATION\"} | logfmt | unwrap bots | __error__=\"\" [10m]) by (bg, realm))",
            "legendFormat": "{{bg}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Expected headcount per battleground",
        "description": "Rows: BG_POPULATION.",
