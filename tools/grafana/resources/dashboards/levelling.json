{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "offlinedaoc-levelling",
    "annotations": {
      "grafana.app/folder": "offlinedaoc-living-server"
    }
  },
  "spec": {
    "title": "Living Server: Levelling",
    "description": "AUTONOMOUS_KILL_XP, AUTONOMOUS_GOAL_ATTEMPT, REALM_LEVEL_SPREAD (#544, #625). Generated by tools/grafana/kit.py; edit dashboards.py, not this file.",
    "tags": [
      "offlinedaoc",
      "living-server"
    ],
    "editable": true,
    "schemaVersion": 41,
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "Loki",
          "type": "datasource",
          "query": "loki",
          "current": {
            "text": "Offline DAoC Loki",
            "value": "offlinedaoc-loki"
          },
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Kill XP per member, median, by realm",
        "description": "Rows: AUTONOMOUS_KILL_XP.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "quantile_over_time(0.5, {job=\"offlinedaoc\", row=\"AUTONOMOUS_KILL_XP\"} | logfmt | unwrap xpPerMember | __error__=\"\" [$__auto]) by (realm)",
            "legendFormat": "{{realm}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Sampled kills by con",
        "description": "Rows: AUTONOMOUS_KILL_XP.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (con) (count_over_time({job=\"offlinedaoc\", row=\"AUTONOMOUS_KILL_XP\"} | logfmt [$__auto]))",
            "legendFormat": "{{con}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Goal attempts finished, by outcome",
        "description": "The row is JSON after its marker; the query strips the marker and reads it with | json.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (outcome) (count_over_time({job=\"offlinedaoc\", row=\"AUTONOMOUS_GOAL_ATTEMPT\"} | regexp `^\\S+ (?P<j>.*)$` | line_format `{{.j}}` | json outcome=\"outcome\" [$__auto]))",
            "legendFormat": "{{outcome}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "REALM_LEVEL_SPREAD rows per realm",
        "description": "Rows: REALM_LEVEL_SPREAD.",
        "datasource": {
          "type": "loki",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "${datasource}"
            },
            "expr": "sum by (realm) (count_over_time({job=\"offlinedaoc\", row=\"REALM_LEVEL_SPREAD\"} [1h]))",
            "legendFormat": "{{realm}}",
            "queryType": "range",
            "editorMode": "code"
          }
        ]
      }
    ]
  }
}
