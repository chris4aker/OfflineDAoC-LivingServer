# Living Server monitoring -> Grafana Cloud (issue #649). Copy to monitoring.env (the install does this), fill it in
# with a text editor, and never commit it or paste it into chat. Values come from grafana.com > your stack > Details.

# Prometheus: "Remote Write Endpoint" and its "Username / Instance ID"
GC_PROM_URL=
GC_PROM_USER=
# Loki: "URL" (the /loki/api/v1/push path is added if missing) and its "User"
GC_LOKI_URL=
GC_LOKI_USER=
# Access policy token with metrics:write and logs:write only (grafana.com > My Account > Access Policies)
GC_TOKEN=

# The server's logs folder: <install>/runtime/server/logs (detect prints it)
LS_LOG_DIR=
# A short name for this PC in Grafana (no personal names needed), e.g. living-server-1
LS_INSTANCE=

# Optional
# The server writes local times; Alloy runs on the same PC, so "Local" (the default) is right. Set an IANA zone such as
# America/New_York only if the server runs in another zone than this PC.
# LS_TZ=Local
# LS_JOB=livingserver
# LS_ALLOY_ADDR=127.0.0.1:12347
