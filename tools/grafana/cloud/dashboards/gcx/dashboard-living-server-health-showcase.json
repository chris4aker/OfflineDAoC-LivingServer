          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${ds_prom}"
            },
            "expr": "max(loki_process_custom_server_memory_heap_mb{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "noValue": "Server stopped",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "#8F3BB8",
                  "value": null
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "value",
          "orientation": "auto",
          "wideLayout": true,
          "showPercentChange": false
        },
        "id": 4,
        "gridPos": {
          "x": 10,
          "y": 4,
          "w": 5,
          "h": 6
        }
      },
