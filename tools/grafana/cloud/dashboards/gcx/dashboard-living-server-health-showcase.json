            },
            "expr": "max(loki_process_custom_ai_tick_p99_ms{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "p99",
            "refId": "C"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${ds_prom}"
            },
            "expr": "max(loki_process_custom_ai_tick_max_ms{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "max",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "noValue": "Server stopped",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 30,
              "gradientMode": "opacity",
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "thresholdsStyle": {
