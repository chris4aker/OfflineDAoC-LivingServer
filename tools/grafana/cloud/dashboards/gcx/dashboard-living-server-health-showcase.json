{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "living-server-health-showcase",
    "annotations": {
      "grafana.app/folder": "living-server"
    }
  },
  "spec": {
    "uid": "living-server-health-showcase",
    "title": "Living Server ✦ Server Health",
    "tags": [
      "living-server-showcase",
      "health"
    ],
    "editable": true,
    "schemaVersion": 39,
    "version": 1,
    "timezone": "browser",
    "graphTooltip": 1,
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "1m",
    "templating": {
      "list": [
        {
          "name": "ds_prom",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "refresh": 1,
          "regex": "/^(?!.*(usage|insights|alert-state|billing|cardinality)).*$/"
        },
        {
          "name": "ds_loki",
          "label": "Loki",
          "type": "datasource",
          "query": "loki",
          "current": {},
          "hide": 0,
          "refresh": 1,
          "regex": "/^(?!.*(usage|insights|alert-state|billing|cardinality)).*$/"
        },
        {
          "name": "job",
          "label": "Job",
          "type": "custom",
          "query": "livingserver,livingserver-test",
          "current": {
            "text": "livingserver",
            "value": "livingserver"
          },
          "options": [],
          "hide": 0
        },
        {
          "name": "instance",
          "label": "Server",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "query": {
            "query": "label_values(loki_process_custom_lines_total{job=\"$job\"}, instance)",
            "refId": "v"
          },
          "definition": "label_values(loki_process_custom_lines_total{job=\"$job\"}, instance)",
          "refresh": 2,
          "includeAll": true,
          "multi": false,
          "allValue": ".*",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "hide": 0,
          "sort": 1
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "links": [
      {
        "type": "dashboards",
        "tags": [
          "living-server-showcase"
        ],
        "asDropdown": true,
        "title": "Living Server",
        "includeVars": true,
        "keepTime": true
      }
    ],
    "panels": [
      {
        "type": "text",
        "title": "",
        "transparent": true,
        "options": {
          "mode": "html",
          "content": "<div style=\"padding:6px 14px;border-left:6px solid #E02F44;background:linear-gradient(90deg, rgba(242,204,12,0.18), rgba(50,116,217,0.10) 60%, transparent)\"><div style=\"font-size:30px;font-weight:700;letter-spacing:1px\">Living Server ✦ Server Health</div><div style=\"font-size:15px;opacity:0.85;margin-top:2px\">Under the hood: tick budget, game services, memory and the error log.</div><div style=\"font-size:14px;margin-top:6px\"><a href=\"/d/living-server-overview-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#bbbbbb\">Overview</a> &nbsp;·&nbsp; <a href=\"/d/living-server-health-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#E02F44\">Server Health</a> &nbsp;·&nbsp; <a href=\"/d/living-server-bots-world-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#bbbbbb\">Bots & World</a></div></div>"
        },
        "id": 1,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 4
        }
      },
      {
        "type": "gauge",
        "title": "🧠 AI tick p99",
        "description": "",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${ds_prom}"
            },
            "expr": "max(loki_process_custom_ai_tick_p99_ms{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "max": 150,
            "noValue": "Server stopped",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 30
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdMarkers": true,
          "showThresholdLabels": false,
          "minVizHeight": 75
        },
        "id": 2,
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 5,
          "h": 6
        }
      },
      {
        "type": "gauge",
        "title": "💾 Heap (live / total)",
        "description": "Live managed memory as a share of the heap.",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${ds_prom}"
            },
            "expr": "max(loki_process_custom_server_memory_live_mb{job=\"$job\", instance=~\"$instance\"}) / max(loki_process_custom_server_memory_heap_mb{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "noValue": "Server stopped",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.8
                },
                {
                  "color": "red",
                  "value": 0.95
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdMarkers": true,
          "showThresholdLabels": false,
          "minVizHeight": 75
        },
        "id": 3,
        "gridPos": {
          "x": 5,
          "y": 4,
          "w": 5,
          "h": 6
        }
      },
