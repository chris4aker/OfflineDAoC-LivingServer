        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "${ds_prom}"
            },
            "expr": "sum(increase(loki_process_custom_lines_total{job=\"$job\", instance=~\"$instance\", event=\"SERVER_GC_PAUSE\"}[1h]))",
            "legendFormat": "",
