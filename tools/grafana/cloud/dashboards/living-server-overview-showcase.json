        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max(loki_process_custom_ai_tick_p50_ms{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max(loki_process_custom_ai_tick_p95_ms{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "p95",
          "refId": "B"
