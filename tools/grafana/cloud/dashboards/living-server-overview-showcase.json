      "description": "Running / Stopped while the collector runs. Blank = collector off.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"})",
          "legendFormat": "CoreServer",
          "refId": "A"
