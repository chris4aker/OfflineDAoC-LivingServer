          "expr": "(label_replace(max(loki_process_custom_bots_online_albion{job=\"$job\", instance=~\"$instance\"}), \"realm\", \"Albion\", \"\", \"\") or label_replace(max(loki_process_custom_bots_online_midgard{job=\"$job\", instance=~\"$instance\"}), \"realm\", \"Midgard\", \"\", \"\") or label_replace(max(loki_process_custom_bots_online_hibernia{job=\"$job\", instance=~\"$instance\"}), \"realm\", \"Hibernia\", \"\", \"\")) and on() (sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) > 0)",
          "legendFormat": "{{realm}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max(loki_process_custom_bots_online{job=\"$job\", instance=~\"$instance\"}) and on() (sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) > 0)",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data: collector off",
