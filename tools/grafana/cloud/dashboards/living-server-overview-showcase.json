    {
      "type": "timeseries",
      "title": "📊 Bots online over time",
      "description": "Per realm and total. Gaps = server stopped or collector off.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
