{
  "uid": "living-server-overview-showcase",
  "title": "Living Server ✦ Overview",
  "tags": [
    "living-server-showcase",
    "overview"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "/^(?!.*(usage|insights|alert-state|billing|cardinality)).*$/"
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "/^(?!.*(usage|insights|alert-state|billing|cardinality)).*$/"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "custom",
        "query": "livingserver,livingserver-test",
        "current": {
          "text": "livingserver",
          "value": "livingserver"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(loki_process_custom_lines_total{job=\"$job\"}, instance)",
          "refId": "v"
        },
        "definition": "label_values(loki_process_custom_lines_total{job=\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "sort": 1
      },
      {
        "name": "node_instance",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(node_uname_info{job=\"integrations/node_exporter\"}, instance)",
          "refId": "n"
        },
        "definition": "label_values(node_uname_info{job=\"integrations/node_exporter\"}, instance)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "living-server-showcase"
      ],
      "asDropdown": true,
      "title": "Living Server",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"padding:6px 14px;border-left:6px solid #F2CC0C;background:linear-gradient(90deg, rgba(242,204,12,0.18), rgba(50,116,217,0.10) 60%, transparent)\"><div style=\"font-size:30px;font-weight:700;letter-spacing:1px\">Living Server ✦ Overview</div><div style=\"font-size:15px;opacity:0.85;margin-top:2px\">Is the world alive? Server, bots, tick and host at a glance.</div><div style=\"font-size:14px;margin-top:6px\"><a href=\"/d/living-server-overview-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#F2CC0C\">Overview</a> &nbsp;·&nbsp; <a href=\"/d/living-server-health-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#bbbbbb\">Server Health</a> &nbsp;·&nbsp; <a href=\"/d/living-server-bots-world-showcase?${__url_time_range}&var-job=${job}\" style=\"color:#bbbbbb\">Bots & World</a></div></div>"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Server",
      "description": "Running / Stopped (collector on) / No data: collector off.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data: collector off",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "#8e8e8e"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "text": "Running",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "⚔️ Bots online",
      "description": "Autonomous bots online (BOT_SKILL_BUDGET, every 5 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "(max(loki_process_custom_bots_online{job=\"$job\", instance=~\"$instance\"}) and on() (sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) > 0)) or on() ((sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) == 0) - 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data: collector off",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Server stopped",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2CC0C",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 64
        }
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "⏳ Uptime",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "(time() - max(namedprocess_namegroup_oldest_start_time_seconds{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) and on() (sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) > 0)) or on() ((sum(namedprocess_namegroup_num_procs{job=\"$job\", instance=~\"$instance\", groupname=\"coreserver\"}) == 0) - 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data: collector off",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Stopped",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8F3BB8",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4,
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 4,
        "h": 6
      }
    },
