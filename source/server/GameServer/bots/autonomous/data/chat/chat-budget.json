// The gamebots' chat budget (Living Server Beta 1.1.3). How it works: docs/bot-voices/CHAT-BUDGETS.md.
//
// Two budgets:
// - "ambient": how much the world talks on its own. Each channel has a floor, a target and a ceiling in lines per
//   minute, as one player hears that channel, at the design point: "design_bots_per_realm" gamebots online in the
//   realm at prime time (a full 2003 server). They are scaled by the hour and by how many bots are online, with no cap.
//   The floor keeps a channel from going dead, the target is the pace bots start lines at, the ceiling counts every
//   bot line in the channel (answers, news and bursts too) and nothing new starts above it.
// - "reply": how sure a bot must be before it answers a player. Below "min_fit" it says nothing, unless it was sent a
//   tell or named, when it gives a short acknowledgement.
//
// Every number here is an estimate [E]. The prime-time values are calibrated against the 2003 chat-volume research
// (research notes "Peak server chat volume 2003", chat_volume.md, section 6 and its texture rules), set toward the
// likely-to-high end of each range because the server should feel busy (owner, 2026-11-03), and never below the
// Beta 1.1.1 volume at 1,000 bots a realm. "/faction", "/lfg" and "/trade" are this server's own realm channels, not
// 2003 channels [O]; they carry the realm-wide talk that 2003 spread over chat groups and guilds.
//
// To tune: copy this file next to the server (runtime/server/chat-budget.json) and edit it; the server reads that copy
// at start instead. bot_voices_chat_rate still multiplies every ambient target (0 = bots only answer).
{
  "version": 1,
  "design_bots_per_realm": 1000,
  // Volume grows as (bots / design_bots_per_realm) ^ exponent: below 1 it rises more slowly than the crowd, and it has
  // no cap (Beta 1.1.1 stopped growing at about 390 bots a realm). 0.75: 300 bots a realm talk at 41% of a full server,
  // 3,000 at 228%. The research suggests conversation grows at least as fast as the crowd; 0.75 keeps small servers alive.
  "population_exponent": 0.75,
  "channels": {
    // Realm-wide talk [O]. No 2003 equivalent; heard everywhere, so it is the player's main sense of the realm.
    "faction":   { "floor": 1.0, "target": 2.5, "ceiling": 6.0, "scale": "realm" },
    // The realm's lfg and trade channels [O] (2003: public chat groups, 1 a minute likely, 3 high).
    "lfg":       { "floor": 0.3, "target": 1.0, "ceiling": 3.0, "scale": "realm" },
    "trade":     { "floor": 0.2, "target": 0.8, "ceiling": 2.5, "scale": "realm" },
    // /say near the player (2003: a busy camp or dungeon area, 0.8 likely, 3 high).
    "say":       { "floor": 0.2, "target": 1.0, "ceiling": 3.0, "scale": "realm" },
    // /broadcast in a capital (2003: 1.5 likely, 4 high at prime time; 70-85% WTS, LFG and recruiting).
    "capital":   { "floor": 0.5, "target": 2.5, "ceiling": 4.0, "scale": "realm" },
    // /broadcast in another town with a broadcast area (2003: a bind town, 0.6 likely, 2 high).
    "town":      { "floor": 0.1, "target": 0.8, "ceiling": 2.0, "scale": "realm" },
    // One guild's chat, at "members" online (2003: 2.5 likely for 50 online, 6 for 150; grows as members ^ 0.8).
    "guild":     { "floor": 0.1, "target": 3.0, "ceiling": 6.0, "scale": "members", "members": 50, "members_exponent": 0.8 },
    // Gamebots' banter in the player's group out of combat (2003: a PvE camp group, 1.5 likely and 4 high, counting
    // everyone and the fight calls, which are separate here). Beta 1.1.1 said a line every 4-8 minutes.
    "group":     { "floor": 0.15, "target": 0.6, "ceiling": 2.0, "scale": "none" }
  },
  // By the PC's local hour, 0-23, prime time = 1. Used when every bot stays online all day (bot_schedule_mode off or
  // session): it carries the whole day's curve (2003: the night trough was 20-35% of prime, and chat fell further).
  "hours": [0.55, 0.42, 0.34, 0.28, 0.28, 0.28, 0.3, 0.34, 0.4, 0.44, 0.48, 0.52, 0.56, 0.56, 0.56, 0.6, 0.68, 0.78, 0.88, 0.95, 1.0, 1.0, 0.95, 0.75],
  // Used with bot_schedule_mode clock, where fewer bots are online at night already: only how much each one talks.
  "hours_clock_schedule": [0.8, 0.7, 0.62, 0.58, 0.58, 0.58, 0.6, 0.66, 0.72, 0.76, 0.8, 0.82, 0.84, 0.84, 0.84, 0.86, 0.9, 0.94, 0.97, 1.0, 1.0, 1.0, 0.98, 0.9],
  "texture": {
    // A seller's WTS line in a capital may become a macro: said again every 3-8 minutes for 15-40 minutes.
    "macro_chance": 0.5, "macro_repeat_min_s": 180, "macro_repeat_max_s": 480, "macro_last_min_s": 900, "macro_last_max_s": 2400,
    // A big moment (a keep, a relic, a raid, a first) draws a burst of 3-6 reactions over about 90 seconds.
    "burst_min": 3, "burst_max": 6, "burst_spread_s": 90
  },
  "reply": {
    // A reply to a player needs this fit (AutonomousChatReplyFit: 4 known, 3 specific, 2 fits, 1 weak).
    "min_fit": 2,
    // After the one primary answer, at most this many short pile-ons ("lol", "+1", "this") in a busy channel.
    "pileon_cap": 2,
    // Typing speeds by personality, words per minute (a word = 5 characters).
    "wpm_min": 25, "wpm_max": 60
  }
}
