<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OfflineDaoc.Launcher\OfflineDaoc.Launcher.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.5.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Setup's base-game downloader (issue #641), tested here against a local HTTP server (FastDownloadTests). -->
    <Compile Include="..\..\..\tools\installer\src\FastDownload.cs" Link="Setup\FastDownload.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded answers of GitHub's releases API for the update tests (no test touches the network). -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
