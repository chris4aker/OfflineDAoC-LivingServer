<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OfflineDAoC</AssemblyName>
    <Product>Offline DAoC: Classic + Shrouded Isles</Product>
    <AssemblyTitle>Offline DAoC Launcher and Population Monitor</AssemblyTitle>
    <!-- Windows enlarges fonts for display scaling; UiScale scales the pixel layout to match. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- Living Server: the build this launcher ships with, read from the server's ForkBuildInfo.BuildName, so the
         update check (Updates/) compares releases with the build that is really installed. -->
    <ForkBuildInfoText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../server/GameServer/gameutils/ForkBuildInfo.cs'))</ForkBuildInfoText>
    <LivingServerBuild>$([System.Text.RegularExpressions.Regex]::Match($(ForkBuildInfoText), 'BuildName = "([^"]+)"').Groups[1].Value)</LivingServerBuild>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LivingServerBuild" Value="$(LivingServerBuild)" />
    <!-- Written to runtime\updates when an update is applied: it runs INSTALL.cmd once the launcher has closed. -->
    <EmbeddedResource Include="Updates\apply-update.ps1" LogicalName="OfflineDaoc.Updates.apply-update.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <Compile Include="../../server/GameServer/bots/autonomous/BotGoalSettings.cs" Link="Configuration/BotGoalSettings.cs" />
    <Compile Include="../../server/GameServer/bots/autonomous/RealmEventRecordStore.cs" Link="Records/RealmEventRecordStore.cs" />
    <Compile Include="../../server/GameServer/Managers/GameLoop/BotAiDelayReport.cs" Link="Records/BotAiDelayReport.cs" />
    <!-- Living Server: the server's own XP-by-level parser, so the launcher checks a setting by the same rules. -->
    <Compile Include="../../server/GameServer/gameutils/LevelRangeXpRates.Parsing.cs" Link="SocialExpansion/LevelRangeXpRates.Parsing.cs" />
    <!-- Living Server: 2003-style bot names, the same mix as the server's own bots. -->
    <Compile Include="../../server/GameServer/bots/autonomous/EraBotNames.cs" Link="SocialExpansion/EraBotNames.cs" />
    <Compile Include="../../server/GameServer/bots/autonomous/EraBotNameWords.cs" Link="SocialExpansion/EraBotNameWords.cs" />
    <!-- Living Server 1.2: the lore bible's channels shared with the server (the Herald's chronicle and bestiary), and the
         lore files themselves, the same ones the server embeds (LauncherLore). -->
    <Compile Include="../../server/GameServer/lorechannels/LoreChannelData.cs" Link="Lore/LoreChannelData.cs" />
    <Compile Include="../../server/GameServer/lorechannels/LoreHerald.cs" Link="Lore/LoreHerald.cs" />
    <EmbeddedResource Include="../../server/GameServer/bots/autonomous/data/lore/**/*.json" LogicalName="OfflineDaoc/lore/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Character passport (from rambodolphin13/DividedRealms): taking a character to a friend's world, by the same rules as
         the server's Passport Desk. -->
    <Compile Include="../OfflineDaoc.Passport/PassportDatabase.cs" Link="Passport/PassportDatabase.cs" />
    <Compile Include="../OfflineDaoc.Passport/PassportEngine.cs" Link="Passport/PassportEngine.cs" />
    <Compile Include="../OfflineDaoc.Passport/PassportFile.cs" Link="Passport/PassportFile.cs" />
    <Compile Include="../OfflineDaoc.Passport/PassportTravel.cs" Link="Passport/PassportTravel.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\offline-daoc-header.png"
                      LogicalName="OfflineDaoc.Launcher.Assets.offline-daoc-header.png" />
    <EmbeddedResource Include="Assets\offline-daoc-realm-emblem.png"
                      LogicalName="OfflineDaoc.Launcher.Assets.offline-daoc-realm-emblem.png" />
  </ItemGroup>
</Project>
