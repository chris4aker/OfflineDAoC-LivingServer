<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OfflineDAoC</AssemblyName>
    <Product>Offline DAoC: Classic + Shrouded Isles</Product>
    <AssemblyTitle>Offline DAoC Launcher and Population Monitor</AssemblyTitle>
    <!-- Windows enlarges fonts for display scaling; UiScale scales the pixel layout to match. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <Compile Include="../../server/GameServer/bots/autonomous/BotGoalSettings.cs" Link="Configuration/BotGoalSettings.cs" />
    <Compile Include="../../server/GameServer/bots/autonomous/RealmEventRecordStore.cs" Link="Records/RealmEventRecordStore.cs" />
    <Compile Include="../../server/GameServer/Managers/GameLoop/BotAiDelayReport.cs" Link="Records/BotAiDelayReport.cs" />
    <!-- Living Server: the server's own XP-by-level parser, so the launcher checks a setting by the same rules. -->
    <Compile Include="../../server/GameServer/gameutils/LevelRangeXpRates.Parsing.cs" Link="SocialExpansion/LevelRangeXpRates.Parsing.cs" />
    <!-- Living Server: 2003-style bot names, the same mix as the server's own bots. -->
    <Compile Include="../../server/GameServer/bots/autonomous/EraBotNames.cs" Link="SocialExpansion/EraBotNames.cs" />
    <Compile Include="../../server/GameServer/bots/autonomous/EraBotNameWords.cs" Link="SocialExpansion/EraBotNameWords.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\offline-daoc-header.png"
                      LogicalName="OfflineDaoc.Launcher.Assets.offline-daoc-header.png" />
    <EmbeddedResource Include="Assets\offline-daoc-realm-emblem.png"
                      LogicalName="OfflineDaoc.Launcher.Assets.offline-daoc-realm-emblem.png" />
  </ItemGroup>
</Project>
